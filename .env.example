# Base de données PostgreSQL (Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Serveur
PORT=5000

# Auth
JWT_SECRET=change_me

# Admin créé automatiquement au premier démarrage
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Email (Gmail app password) pour la réinitialisation de mot de passe
GMAIL_USER=
GMAIL_PASS=

# APIs externes
YOUTUBE_API_KEY=
OPENROUTER_API_KEY=

# Google Gemini — quiz de fin de formation (clé gratuite : https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optionnel : modèle Gemini (défaut gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary — upload des avatars (dashboard : https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend (liens dans les emails)
FRONTEND_URL=http://localhost:5173

# FedaPay (paiement des abonnements) — clés sandbox sur https://sandbox.fedapay.com
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_WEBHOOK_SECRET=
# Prix de l'abonnement mensuel en francs CFA
ABONNEMENT_PRIX_XOF=5000
